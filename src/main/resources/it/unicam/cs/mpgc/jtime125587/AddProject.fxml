<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<DialogPane maxHeight="-Infinity" minHeight="-Infinity" prefHeight="175.0" prefWidth="300.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <header>
        <Label alignment="CENTER" prefHeight="40.0" prefWidth="300.0" text="Add Project">
            <font>
                <Font name="System Italic" size="14.0" />
            </font>
        </Label>
    </header>
    <content>
        <GridPane minHeight="-Infinity" prefHeight="300.0" prefWidth="300.0">
            <columnConstraints>
                <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" maxWidth="-Infinity" minWidth="-Infinity" prefWidth="280.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints maxHeight="-Infinity" minHeight="-Infinity" prefHeight="50.0" vgrow="SOMETIMES" />
                <RowConstraints maxHeight="-Infinity" minHeight="-Infinity" prefHeight="50.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <TextField maxWidth="-Infinity" prefWidth="135.0" promptText="Name" />
            <GridPane GridPane.rowIndex="1">
              <columnConstraints>
                <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <Button mnemonicParsing="false" text="Add">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font></Button>
                      <Button mnemonicParsing="false" text="Cancel" textFill="RED" GridPane.columnIndex="1">
                          <font>
                              <Font name="System Bold" size="12.0" />
                          </font>
                      </Button>
               </children>
            </GridPane>
            </children>
        </GridPane>
    </content>
</DialogPane>
